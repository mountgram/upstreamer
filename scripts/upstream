#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 <codebase> [--force] [-- <extra opencode args>]" >&2
  echo "Example: $0 tstack" >&2
  echo "Example: $0 last30days-ts --force" >&2
  echo "Example: OPENCODE_MODEL=anthropic/claude-sonnet-4-5 $0 tstack" >&2
  echo "Example: UPSTREAMER_TIMEOUT_SECONDS=3600 $0 tstack" >&2
}

read_frontmatter_field() {
  local file="$1"
  local field="$2"
  local line line_number=0 value

  while IFS= read -r line; do
    line_number=$((line_number + 1))

    if [ "$line_number" -eq 1 ]; then
      [ "$line" = "---" ] || return 0
      continue
    fi

    [ "$line" = "---" ] && return 0

    case "$line" in
      "$field":*)
        value="${line#"$field":}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        value="${value%\"}"
        value="${value#\"}"
        value="${value%\'}"
        value="${value#\'}"
        printf '%s\n' "$value"
        return 0
        ;;
    esac
  done < "$file"
}

if [ "$#" -lt 1 ]; then
  usage
  exit 2
fi

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac

codebase="$1"
shift
force=0

while [ "$#" -gt 0 ]; do
  case "${1:-}" in
    --force)
      force=1
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [ "${1:-}" = "--" ]; then
  shift
fi

case "$codebase" in
  *[!A-Za-z0-9._-]* | "")
    echo "ERROR: invalid codebase name: $codebase" >&2
    exit 2
    ;;
esac

contract="codebases/$codebase/upstreamer.md"
skill=".agents/skills/upstreamer-converter/SKILL.md"
workspace_tmp="tmp/upstreamer/$codebase"
upstream_dir="$workspace_tmp/upstream"
downstream_dir="codebases/$codebase/downstream"
log_dir="codebases/$codebase/.upstreamer/logs"
state_file="codebases/$codebase/.upstreamer/state.yaml"
verifier="codebases/$codebase/.upstreamer/scripts/verify-$codebase.sh"
eval_file="codebases/$codebase/.upstreamer/eval.md"
eval_report_file="codebases/$codebase/.upstreamer/eval-report.md"

if [ ! -f "$contract" ]; then
  echo "ERROR: missing rewrite contract: $contract" >&2
  exit 2
fi

if [ ! -f "$skill" ]; then
  echo "ERROR: missing converter skill: $skill" >&2
  exit 2
fi

mkdir -p "$workspace_tmp" "$log_dir"
export TMPDIR="$PWD/$workspace_tmp"
log_file="$log_dir/$(date -u +%Y%m%dT%H%M%SZ).log"
last_upstream_commit=""

if [ -f "$state_file" ]; then
  last_upstream_commit="$(awk -F: '$1 == "upstream_commit" { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }' "$state_file")"
fi

frontmatter_model="$(read_frontmatter_field "$contract" model)"
upstream_repo="$(read_frontmatter_field "$contract" upstream)"

model_args=()
if [ -n "${OPENCODE_MODEL:-}" ]; then
  model_args=(--model "$OPENCODE_MODEL")
elif [ -n "$frontmatter_model" ]; then
  model_args=(--model "$frontmatter_model")
fi

if [ "$force" -eq 0 ] && [ -n "$last_upstream_commit" ] && [ -d "$downstream_dir" ] && [ -n "$upstream_repo" ]; then
  upstream_url="$upstream_repo"
  case "$upstream_url" in
    http://* | https://* | git@*) ;;
    *) upstream_url="https://github.com/$upstream_url.git" ;;
  esac

  if [ -d "$upstream_dir/.git" ]; then
    git -C "$upstream_dir" remote set-url origin "$upstream_url" >/dev/null 2>&1 || true
    git -C "$upstream_dir" fetch origin >/dev/null 2>&1 || true
  else
    rm -rf "$upstream_dir"
    git clone "$upstream_url" "$upstream_dir" >/dev/null 2>&1 || true
  fi

  if [ -d "$upstream_dir/.git" ]; then
    current_upstream_commit="$(
      git -C "$upstream_dir" rev-parse refs/remotes/origin/HEAD 2>/dev/null ||
        git -C "$upstream_dir" rev-parse origin/HEAD 2>/dev/null ||
        git -C "$upstream_dir" rev-parse HEAD 2>/dev/null ||
        true
    )"

    if [ -n "$current_upstream_commit" ] && [ "$current_upstream_commit" = "$last_upstream_commit" ]; then
      echo "Writing opencode log to $log_file" >&2
      {
        echo "Run summary"
        echo "==========="
        echo "Upstream changes since last run: none."
        echo "Downstream changes made: none; existing downstream output was left unchanged."
        echo "Verification: running unchanged-output verifier."
        echo
        echo "Upstream commit: $current_upstream_commit"
        echo "Last processed: $last_upstream_commit"

        if [ -x "$verifier" ]; then
          echo
          echo "Running verifier: $verifier $downstream_dir"
          "$verifier" "$downstream_dir"
        else
          echo
          echo "No executable verifier found at $verifier"
        fi
      } 2>&1 | tee "$log_file"
      exit "${PIPESTATUS[0]}"
    fi
  fi
fi

prompt=$(cat <<EOF
Use the upstreamer-converter skill at @$skill to convert the codebase defined by @$contract.

Stay inside this workspace. Clone or copy upstream sources under @$upstream_dir and write downstream output under @$downstream_dir unless the contract explicitly says otherwise. Use @tmp/upstreamer/$codebase for temporary work. Do not use /tmp or any other external directory.

Track upstream sync state in @$state_file. The last processed upstream commit is: ${last_upstream_commit:-none}. Force conversion is: $force. If force conversion is 1, run the conversion even when the upstream commit is unchanged because the local contract may have changed. If a last commit exists and force conversion is 0, inspect upstream changes since that commit first and update the existing downstream output instead of redoing unrelated work. If no last commit exists, perform a full conversion. After successful verification, update @$state_file with the exact upstream commit processed as upstream_commit: <sha>.

Read both files first and treat @$contract as the binding rewrite contract. Execute the conversion end-to-end: acquire the upstream repo, inventory every upstream SKILL.md, decide KEEP/ADAPT/DROP, write the downstream output, run the contract verification including any bundled .upstreamer scripts, run @$eval_file in a fresh subagent or separate review context if it exists, fix violations, and return the final report requested by the contract.

If @$eval_file exists, write the latest qualitative eval result to @$eval_report_file. If the eval fails, fix the downstream or contract, rerun mechanical verification, and rerun the eval. Repeat until the eval passes or passes with warnings, or until three focused fix/eval attempts have failed or no coherent fix remains. If the eval still fails, declare bankruptcy: do not update @$state_file, write the failed eval result plus attempted fixes and recommended human next action to @$eval_report_file, and make the final report clearly say eval failed.

The final report must begin with a "Run summary" section that explains what changed upstream since the last verified run and what you put into the downstream output in response. Keep it useful at a glance for a busy engineer: notable upstream features or behavior changes, downstream files/features/skills added or adapted, why the choices match the contract, verification result, qualitative eval result if an eval exists, and the eval report path. If this is a full conversion with no previous commit, summarize the upstream snapshot used instead of an incremental diff.

Also update @$downstream_dir/upstreamer-changelog.md with the same user-facing summary in concise changelog form. The downstream changelog is for users of the generated repo, so do not include commit hashes, .upstreamer/state.yaml changes, verifier internals, or sync bookkeeping there.

This is a non-interactive run. Do not wait for follow-up instructions after the final report. If blocked, write a final report explaining the blocker and stop. After the final report is complete, exit the opencode run.
EOF
)

echo "Writing opencode log to $log_file" >&2

if [ -n "${UPSTREAMER_TIMEOUT_SECONDS:-}" ]; then
  perl -e 'alarm shift; exec @ARGV' "$UPSTREAMER_TIMEOUT_SECONDS" \
    opencode "${model_args[@]}" "$@" run "$prompt" 2>&1 | tee "$log_file"
else
  opencode "${model_args[@]}" "$@" run "$prompt" 2>&1 | tee "$log_file"
fi
