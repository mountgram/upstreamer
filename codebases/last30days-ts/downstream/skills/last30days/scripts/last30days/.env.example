# Copy this file to .env and fill in the keys you want to enable.
# EXA_API_KEY is preferred for reliable web search. BRAVE_API_KEY is supported as a fallback.
# No key is required for baseline research.

# --- Web Search ---
# Preferred reliable web search (exa.ai)
EXA_API_KEY=
# Alternative/fallback web search (2000 free queries/month)
BRAVE_API_KEY=
# Enables Serper (Google) web search
SERPER_API_KEY=
# Enables Parallel AI web search
PARALLEL_API_KEY=
# Enables OpenAI Responses API web search grounding. Prefer this over Sonar when you need LLM-grounded web search.
OPENAI_API_KEY=

# --- AI Provider APIs ---
# For Gemini YouTube video understanding and Google Maps grounding
GEMINI_API_KEY=
# For Perplexity/Sonar grounded web search via OpenRouter. Expensive; opt in with --web-backend perplexity or --include-sources perplexity.
OPENROUTER_API_KEY=
# For X/Twitter search via xAI/Grok API (XAI_API_KEY and GROK_API_KEY are aliases)
XAI_API_KEY=
GROK_API_KEY=

# --- Social Media ---
# For Reddit, HN, Polymarket, GitHub, Weather/Open-Meteo, and Health: no key required (public APIs)
# For Bluesky AT Protocol
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# For Truth Social (Mastodon-compatible API)
TRUTHSOCIAL_TOKEN=
# For ScrapeCreators-backed sources: TikTok, Instagram, Threads, Pinterest, LinkedIn, Meta Ads, Telegram
SCRAPECREATORS_API_KEY=
# For Apify-backed sources
APIFY_API_TOKEN=

# --- Telegram Channels (optional; comma-separated public channel handles) ---
# Required (with SCRAPECREATORS_API_KEY) for the Telegram source. Accepts
# bare handles, @handles, or t.me URLs. Private joinchat links are unsupported.
TELEGRAM_SOURCES=

# --- Amazon Buyer Signals (optional; Bright Data CLI) ---
# Enables the Amazon source when the `brightdata` CLI is on PATH. The CLI can
# also own its credentials via `brightdata login`; set this key to use an
# explicit API key instead.
BRIGHTDATA_API_KEY=

# --- DripStack (premium financial newsletters; no key required) ---
# Public search API, auto-gated on finance/analyst topics.

# --- GitHub (optional; raises rate limit from 60 to 5000 req/hr) ---
GITHUB_TOKEN=

# --- Optional Binary Paths ---
# Install these via package manager or from their repos:
#   yt-dlp: brew install yt-dlp (YouTube transcripts)
#   digg-pp-cli: from @mvanhorn/printing-press-library (Digg AI headlines)
#   arxiv-pp-cli: from @mvanhorn/printing-press-library (arXiv papers)
#   techmeme-pp-cli: from @mvanhorn/printing-press-library (Techmeme headlines)
#   trustpilot-pp-cli: from @mvanhorn/printing-press-library (Trustpilot brand sentiment)

# --- Trustpilot Opt-Out (set to 1 to disable in headless/cron) ---
LAST30DAYS_TRUSTPILOT_NO_BROWSER=

# --- Output ---
# Directory for saved research briefs (default: ./output)
LAST30DAYS_DIR=
