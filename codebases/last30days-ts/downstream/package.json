{
  "name": "last30days-ts",
  "version": "0.1.0",
  "description": "Research what people say about any topic in the last 30 days — ported from Python to TypeScript",
  "repository": "github:mountgram/last30days-ts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "last30days": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "eval:offline": "tsx eval/run.ts --offline"
  },
  "dependencies": {
    "exa-js": "^1.3.0",
    "openai": "^4.104.0",
    "duck-duck-scrape": "^2.2.6",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "tsx": "^4.19.0"
  }
}
