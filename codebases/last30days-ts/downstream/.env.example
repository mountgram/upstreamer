# Last30Days TS optional source configuration.
# Copy to .env for local development or export the variables directly.
# Leave values empty for sources you do not want to enable.

# Web search adapters
EXA_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
PARALLEL_API_KEY=

# GitHub adapter. Optional; unauthenticated GitHub search still works with lower rate limits.
GITHUB_TOKEN=

# ScrapeCreators-backed social adapters: TikTok, Instagram, Threads, Pinterest, Xiaohongshu, and optional Truth Social paths.
SCRAPECREATORS_API_KEY=

# Perplexity/Sonar grounded web adapter through OpenRouter only.
OPENROUTER_API_KEY=

# X/Twitter adapter auth. AUTH_TOKEN and CT0 are cookie values for X only.
AUTH_TOKEN=
CT0=

# X/xAI aliases for retained X source paths only; neither is a global model-planning key.
XAI_API_KEY=
GROK_API_KEY=

# Bluesky authenticated paths. Public Bluesky search works without these.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Truth Social direct adapter path.
TRUTHSOCIAL_TOKEN=

# Retained Apify-backed social adapters.
APIFY_API_TOKEN=

# Output/cache directory for saved briefs and optional setup helper output.
LAST30DAYS_DIR=
